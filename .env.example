# --- NVIDIA NIM (image generation) ---
NVIDIA_API_KEY=nvapi-YOUR_KEY_HERE
NVIDIA_KEY_EXPIRY=2027-02-15

# --- Groq (text generation) ---
GROQ_API_KEY=gsk_YOUR_KEY_HERE

# --- Image provider: "nvidia" or "comfy" ---
IMAGE_PROVIDER=nvidia

# --- Text provider: "groq" or "ollama" ---
TEXT_PROVIDER=groq